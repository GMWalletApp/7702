# ==============================================================================
# EIP-7702 Sponsored Account environment template
# ==============================================================================
# Copy this file to `.env` before running scripts:
#
#   cp .env.example .env
#
# SECURITY:
# - Never commit `.env`.
# - Never paste private keys into issues, PRs, chats, or logs.
# - Values below are placeholders. Replace them with your own addresses/keys.
#
# Naming rule:
# - Chain-specific variables, for example `ARBITRUM_ONE_FEE_TOKEN_ADDRESS`, take
#   priority over common variables.
# - If a chain-specific variable is missing, scripts fall back to the common
#   variable with the same suffix, for example `FEE_TOKEN_ADDRESS`.
# ==============================================================================

# ===== Common accounts: reused across EVM chains =====

# User private key. The derived address must equal USER_ADDRESS.
# Used to sign EIP-712 SponsoredCall requests and EIP-7702 authorizations.
USER_PRIVATE_KEY=0xYOUR_USER_PRIVATE_KEY

# Sponsor private key. The derived address must equal SPONSOR_ADDRESS.
# Used by sponsor scripts to submit executeSponsored transactions and pay native gas.
SPONSOR_PRIVATE_KEY=0xYOUR_SPONSOR_PRIVATE_KEY

# User EOA address that owns token funds and delegates to Sponsored7702Account via EIP-7702.
USER_ADDRESS=0xYOUR_USER_ADDRESS

# Sponsor/relayer address allowed by SponsorPolicyRegistry.
SPONSOR_ADDRESS=0xYOUR_SPONSOR_ADDRESS

# Default business payment recipient. Batch payment variables can override this.
MERCHANT_ADDRESS=0xYOUR_MERCHANT_OR_RECIPIENT_ADDRESS

# Registry owner address. This must be the address derived from each chain's deploy/config private key.
INITIAL_OWNER=0xYOUR_REGISTRY_OWNER_ADDRESS

# Address receiving gas/service fee repayment in ERC-20 tokens.
INITIAL_FEE_RECEIVER=0xYOUR_FEE_RECEIVER_ADDRESS

# Incoming owner for deploy/transfer-ownership.ts. Only read by that script.
# Ownership moves in two steps and the second is signed by this address, so
# the two steps need different values in <CHAIN>_PRIVATE_KEY.
# NEW_OWNER=0xYOUR_NEW_REGISTRY_OWNER_ADDRESS

# Optional reference token that must stay OUT of the fee token allowlist.
# configure scripts only report its status; they never enable it. Used as the
# negative case by scripts/bsc-testnet/check-unsupported-fee-token.ts.
# UNSUPPORTED_FEE_TOKEN=0xYOUR_DELIBERATELY_UNSUPPORTED_TOKEN

# User signature validity window in seconds.
SPONSORED_CALL_DEADLINE_SECONDS=3600

# Optional service fee charged in the fee token's smallest unit.
# Example: for USDC with 6 decimals, 10000 = 0.01 USDC.
SERVICE_FEE_AMOUNT=0

# Global max service fee allowed by registry fee policy.
MAX_SERVICE_FEE_AMOUNT=0

# Max number of business calls allowed in one sponsored batch.
# Set to 0 to disable the limit.
MAX_CALLS=10

# Confirms that the current platform-subsidized mode is intentional.
# Sponsored7702Account skips ERC-20 repayment entirely when the total fee is
# zero; the user pays only the business amount and the sponsor pays native gas.
SPONSORED_ALLOW_ZERO_FEE=true

# ===== Ethereum Mainnet =====

# Ethereum Mainnet RPC URL.
ETHEREUM_RPC_URL=YOUR_ETHEREUM_MAINNET_RPC_URL

# Deployer/config private key for Ethereum Mainnet.
# The derived address must equal INITIAL_OWNER unless ETHEREUM_INITIAL_OWNER is set.
ETHEREUM_PRIVATE_KEY=0xYOUR_ETHEREUM_MAINNET_OWNER_PRIVATE_KEY

# Fill these after running:
#   IGNITION_DEPLOYMENT_ID=chain-1-router-v2-owner npm run deploy:contracts:ethereum
ETHEREUM_POLICY_REGISTRY=0xDEPLOYED_ETHEREUM_POLICY_REGISTRY
ETHEREUM_ACCOUNT_IMPLEMENTATION=0xDEPLOYED_ETHEREUM_ACCOUNT_IMPLEMENTATION
ETHEREUM_SPONSOR_ROUTER=0xDEPLOYED_ETHEREUM_SPONSOR_ROUTER

# Ethereum Mainnet per-chain sponsor override. Falls back to SPONSOR_ADDRESS when unset.
ETHEREUM_SPONSOR_ADDRESS=0xYOUR_ETHEREUM_MAINNET_SPONSOR_ADDRESS

# Canonical Ethereum USDC. Ethereum mainnet canary scripts intentionally allow only this token.
ETHEREUM_USDC_TOKEN_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETHEREUM_FEE_TOKEN_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETHEREUM_SUPPORTED_FEE_TOKENS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Ethereum USDC uses 6 decimals.
# 1000 = 0.001 USDC.
# This is only a tiny functional canary amount, not a production gas quote.
ETHEREUM_PAYMENT_AMOUNT=1000
ETHEREUM_GAS_FEE_AMOUNT=0

# Registry fee policy limits in Ethereum USDC smallest unit.
ETHEREUM_MAX_GAS_FEE_AMOUNT=0
ETHEREUM_MAX_TOTAL_FEE_AMOUNT=0

# Optional Ethereum-only max call override.
# If omitted, scripts use common MAX_CALLS.
# ETHEREUM_MAX_CALLS=10

# Minimum native ETH balance required before submitting the Ethereum sponsored request.
# 1000000000000000 = 0.001 ETH.
ETHEREUM_RELAYER_MIN_NATIVE_BALANCE=1000000000000000

# ===== Arbitrum One =====

# Arbitrum One RPC URL.
ARBITRUM_ONE_RPC_URL=YOUR_ARBITRUM_ONE_RPC_URL

# Deployer/config private key for Arbitrum One.
# The derived address must equal INITIAL_OWNER unless ARBITRUM_ONE_INITIAL_OWNER is set.
ARBITRUM_ONE_PRIVATE_KEY=0xYOUR_ARBITRUM_ONE_OWNER_PRIVATE_KEY

# Fill these after running:
#   npm run deploy:contracts:arbitrum-one
ARBITRUM_ONE_POLICY_REGISTRY=0xDEPLOYED_ARBITRUM_POLICY_REGISTRY
ARBITRUM_ONE_ACCOUNT_IMPLEMENTATION=0xDEPLOYED_ARBITRUM_ACCOUNT_IMPLEMENTATION
ARBITRUM_ONE_SPONSOR_ROUTER=0xDEPLOYED_ARBITRUM_SPONSOR_ROUTER

# Arbitrum One per-chain sponsor override. Falls back to SPONSOR_ADDRESS when unset.
ARBITRUM_ONE_SPONSOR_ADDRESS=0xYOUR_ARBITRUM_ONE_SPONSOR_ADDRESS

# Arbitrum native USDC token address.
# Replace only if you intentionally use another token and update scripts accordingly.
ARBITRUM_ONE_USDC_TOKEN_ADDRESS=0xARBITRUM_ONE_NATIVE_USDC_ADDRESS

# ERC-20 token used by the user to repay gas/service fee.
ARBITRUM_ONE_FEE_TOKEN_ADDRESS=0xARBITRUM_ONE_FEE_TOKEN_ADDRESS

# Comma-separated supported fee tokens for registry configuration.
ARBITRUM_ONE_SUPPORTED_FEE_TOKENS=0xARBITRUM_ONE_SUPPORTED_FEE_TOKEN_ADDRESS

# Default single-recipient payment amount in token smallest unit.
# For Arbitrum native USDC with 6 decimals:
# - 1000   = 0.001 USDC
# - 10000  = 0.01 USDC
# - 100000 = 0.1 USDC
ARBITRUM_ONE_PAYMENT_AMOUNT=1000

# Optional batch payment override.
# If these are set, scripts use recipients/amounts below instead of MERCHANT_ADDRESS + ARBITRUM_ONE_PAYMENT_AMOUNT.
# Counts must match, and each amount is in token smallest unit.
# ARBITRUM_ONE_PAYMENT_RECIPIENTS=0xRECIPIENT_1,0xRECIPIENT_2
# ARBITRUM_ONE_PAYMENT_AMOUNTS=1000,1000

# Gas repayment amount charged to the user in fee token smallest unit.
ARBITRUM_ONE_GAS_FEE_AMOUNT=0

# Registry fee policy limits in fee token smallest unit.
ARBITRUM_ONE_MAX_GAS_FEE_AMOUNT=0
ARBITRUM_ONE_MAX_TOTAL_FEE_AMOUNT=0

# Optional Arbitrum-only max call override.
# If omitted, scripts use common MAX_CALLS.
# ARBITRUM_ONE_MAX_CALLS=10

# Optional minimum native ETH balance required before submitting the Arbitrum sponsored request.
ARBITRUM_ONE_RELAYER_MIN_NATIVE_BALANCE=0

# ===== BSC Mainnet =====

# BSC Mainnet RPC URL.
BSC_RPC_URL=YOUR_BSC_MAINNET_RPC_URL

# Deployer/config private key for BSC Mainnet.
# The derived address must equal INITIAL_OWNER unless BSC_INITIAL_OWNER is set.
BSC_PRIVATE_KEY=0xYOUR_BSC_MAINNET_OWNER_PRIVATE_KEY

# Fill these after running:
#   npm run deploy:contracts:bsc
BSC_POLICY_REGISTRY=0xDEPLOYED_BSC_POLICY_REGISTRY
BSC_ACCOUNT_IMPLEMENTATION=0xDEPLOYED_BSC_ACCOUNT_IMPLEMENTATION
BSC_SPONSOR_ROUTER=0xDEPLOYED_BSC_SPONSOR_ROUTER

# BSC Mainnet per-chain sponsor override. Falls back to SPONSOR_ADDRESS when unset.
BSC_SPONSOR_ADDRESS=0xYOUR_BSC_MAINNET_SPONSOR_ADDRESS

# Canonical BSC USDT. BSC mainnet canary scripts intentionally allow only this token.
BSC_USDT_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
BSC_FEE_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
BSC_SUPPORTED_FEE_TOKENS=0x55d398326f99059fF775485246999027B3197955

# BSC USDT uses 18 decimals.
# 1000000000000000 = 0.001 USDT.
# Before a real call, manually confirm these are still tiny canary amounts.
BSC_PAYMENT_AMOUNT=1000000000000000
BSC_GAS_FEE_AMOUNT=0

# Registry fee policy limits in BSC USDT smallest unit.
BSC_MAX_GAS_FEE_AMOUNT=0
BSC_MAX_TOTAL_FEE_AMOUNT=0

# Optional BSC-only max call override.
# If omitted, scripts use common MAX_CALLS.
# BSC_MAX_CALLS=10

# Optional minimum native BNB balance required before submitting the BSC sponsored request.
BSC_RELAYER_MIN_NATIVE_BALANCE=0

# ===== BSC Testnet =====

# BSC Testnet RPC URL.
BSC_TESTNET_RPC_URL=YOUR_BSC_TESTNET_RPC_URL

# Deployer/config private key for BSC Testnet.
# The derived address must equal INITIAL_OWNER unless BSC_TESTNET_INITIAL_OWNER is set.
BSC_TESTNET_PRIVATE_KEY=0xYOUR_BSC_TESTNET_OWNER_PRIVATE_KEY

# Fill these after running:
#   npm run deploy:contracts:bsc-testnet
BSC_TESTNET_POLICY_REGISTRY=0xDEPLOYED_BSC_TESTNET_POLICY_REGISTRY
BSC_TESTNET_ACCOUNT_IMPLEMENTATION=0xDEPLOYED_BSC_TESTNET_ACCOUNT_IMPLEMENTATION
BSC_TESTNET_SPONSOR_ROUTER=0xDEPLOYED_BSC_TESTNET_SPONSOR_ROUTER

# Fill these after running:
#   npm run deploy:mocks:bsc-testnet
BSC_TESTNET_TARGET_ADDRESS=0xDEPLOYED_BSC_TESTNET_MOCK_TARGET
BSC_TESTNET_USDT_TOKEN_ADDRESS=0xDEPLOYED_BSC_TESTNET_MOCK_USDT
BSC_TESTNET_USDC_TOKEN_ADDRESS=0xDEPLOYED_BSC_TESTNET_MOCK_USDC
BSC_TESTNET_USDG_TOKEN_ADDRESS=0xDEPLOYED_BSC_TESTNET_MOCK_USDG

# Fee tokens enabled by npm run configure:bsc-testnet.
BSC_TESTNET_SUPPORTED_FEE_TOKENS=0xBSC_TESTNET_USDT,0xBSC_TESTNET_USDC

# USDG stays out of the allowlist on purpose: it is the negative case for
# scripts/bsc-testnet/check-unsupported-fee-token.ts.
BSC_TESTNET_UNSUPPORTED_FEE_TOKEN=0xBSC_TESTNET_USDG

# Token used by BSC Testnet examples to repay gas/service fee.
BSC_TESTNET_FEE_TOKEN_ADDRESS=0xBSC_TESTNET_FEE_TOKEN_ADDRESS

# BSC Testnet mock tokens in this project use 18 decimals.
# 100000000000000000 = 0.1 token.
BSC_TESTNET_PAYMENT_AMOUNT=100000000000000000

# Gas repayment and fee policy amounts in token smallest unit.
BSC_TESTNET_GAS_FEE_AMOUNT=0
BSC_TESTNET_MAX_GAS_FEE_AMOUNT=0
BSC_TESTNET_MAX_TOTAL_FEE_AMOUNT=0

# Optional BSC Testnet-only max call override.
# If omitted, scripts use common MAX_CALLS.
# BSC_TESTNET_MAX_CALLS=10

# BSC Testnet per-chain sponsor override. Falls back to SPONSOR_ADDRESS when unset.
BSC_TESTNET_SPONSOR_ADDRESS=0xYOUR_BSC_TESTNET_SPONSOR_ADDRESS

# Optional minimum native tBNB balance required before submitting the BSC Testnet sponsored request.
BSC_TESTNET_RELAYER_MIN_NATIVE_BALANCE=0

# ===== Polygon PoS Mainnet =====

POLYGON_RPC_URL=YOUR_POLYGON_MAINNET_RPC_URL

# Required only for deployment and owner-only operations. The self-relayer
# payment runner uses USER_PRIVATE_KEY and SPONSOR_PRIVATE_KEY instead.
# When set, the derived address must equal POLYGON_INITIAL_OWNER or INITIAL_OWNER.
POLYGON_PRIVATE_KEY=0xYOUR_POLYGON_MAINNET_OWNER_PRIVATE_KEY

# Deployed on 2026-08-11 with the production build profile.
POLYGON_POLICY_REGISTRY=0xabeA8fF5e60FFe326ba431113b9EEeC70Dcfb8Be
POLYGON_ACCOUNT_IMPLEMENTATION=0x1f62534e8b753033e02fF579D4eC6231B6645aBc
POLYGON_SPONSOR_ROUTER=0x9d4Fbb71886d6FC55239563D92ac7054d63afF27

# Optional per-chain override; falls back to SPONSOR_ADDRESS.
POLYGON_SPONSOR_ADDRESS=0xYOUR_POLYGON_SPONSOR_ADDRESS

# Polygon PoS native USDC (6 decimals).
POLYGON_USDC_TOKEN_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
POLYGON_FEE_TOKEN_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
POLYGON_SUPPORTED_FEE_TOKENS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# 1000 = 0.001 USDC business payment. Fees remain zero in pure subsidy mode.
POLYGON_PAYMENT_AMOUNT=1000
POLYGON_GAS_FEE_AMOUNT=0
POLYGON_MAX_GAS_FEE_AMOUNT=0
POLYGON_MAX_TOTAL_FEE_AMOUNT=0
POLYGON_MAX_CALLS=10

# Sponsor pays POL gas; use a production safety threshold here.
POLYGON_RELAYER_MIN_NATIVE_BALANCE=100000000000000000

# ===== Self-relayer canary (feat/self-relayer only) =====
#
# Per-target amount for evm-7702-sponsored/scripts/run-self-relayer-canary.ts,
# in the fee token's base units. Falls back to a small per-target default when
# unset. Keep it minimal: the canary proves the path works, it is not a load
# test, and without --dry-run every passing target spends real funds.
# BSC_TESTNET_CANARY_AMOUNT=1000000000000000
# ARBITRUM_ONE_CANARY_AMOUNT=1000
# BSC_CANARY_AMOUNT=1000000000000000
# ETHEREUM_CANARY_AMOUNT=1000
# POLYGON_CANARY_AMOUNT=1000
